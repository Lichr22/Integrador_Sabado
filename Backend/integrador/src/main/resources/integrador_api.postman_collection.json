{
  "info": {
    "name": "Integrador API",
    "_postman_id": "integrador-api-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "categoria_id", "value": "", "type": "string" },
    { "key": "empresa_id", "value": "", "type": "string" },
    { "key": "prioridad_id", "value": "", "type": "string" },
    { "key": "usuario_id", "value": "", "type": "string" },
    { "key": "reto_id", "value": "", "type": "string" },
    { "key": "registro_id", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Register",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Admin Prueba\",\n  \"correo\": \"admin@prueba.com\",\n  \"contrasena\": \"password123\"\n}" }
          }
        },
        {
          "name": "POST Login",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"admin@prueba.com\",\n  \"contrasena\": \"password123\"\n}" }
          }
        },
        {
          "name": "GET Me",
          "request": { "method": "GET", "url": "{{base_url}}/api/auth/me" }
        }
      ]
    },
    {
      "name": "Categorias",
      "item": [
        {
          "name": "GET All Categorias",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/categorias" }
        },
        {
          "name": "GET Categoria by ID",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/categorias/{{categoria_id}}" }
        },
        {
          "name": "POST Crear Categoria",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('categoria_id', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/categorias",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Innovacion Digital\",\n  \"descripcion\": \"Categoria enfocada en transformacion digital\",\n  \"areaResponsable\": \"TI\"\n}" }
          }
        },
        {
          "name": "PUT Actualizar Categoria",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/categorias/{{categoria_id}}",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Innovacion Digital Actualizada\",\n  \"descripcion\": \"Descripcion actualizada\",\n  \"areaResponsable\": \"Innovacion\"\n}" }
          }
        },
        {
          "name": "DELETE Categoria",
          "request": { "method": "DELETE", "url": "{{base_url}}/api/v1/categorias/{{categoria_id}}" }
        }
      ]
    },
    {
      "name": "Prioridades",
