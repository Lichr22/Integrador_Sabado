          }
        },
        {
          "name": "DELETE Usuario",
          "request": { "method": "DELETE", "url": "{{base_url}}/api/v1/usuarios/{{usuario_id}}" }
        }
      ]
    },
    {
      "name": "Retos",
      "item": [
        {
          "name": "GET All Retos",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/retos" }
