          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('reto_id', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/retos",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Reto de Automatizacion\",\n  \"descripcion\": \"Automatizar procesos internos\",\n  \"fechaInicio\": \"2025-01-01\",\n  \"fechaFin\": \"2025-06-30\",\n  \"estado\": \"abierto\",\n  \"idEmpresa\": \"{{empresa_id}}\",\n  \"idCategoria\": \"{{categoria_id}}\",\n  \"idPrioridad\": \"{{prioridad_id}}\"\n}" }
