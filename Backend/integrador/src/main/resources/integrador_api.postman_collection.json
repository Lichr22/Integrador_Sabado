            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/usuarios",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Carlos Ramirez\",\n  \"correo\": \"carlos.ramirez@correo.com\",\n  \"contrasenaHash\": \"password123\",\n  \"activo\": true,\n  \"rol\": \"usuario\"\n}" }
          }
