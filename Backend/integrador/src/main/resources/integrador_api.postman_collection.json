        {
          "name": "DELETE Reto",
          "request": { "method": "DELETE", "url": "{{base_url}}/api/v1/retos/{{reto_id}}" }
        }
      ]
    },
    {
      "name": "Registros",
      "item": [
        {
          "name": "GET All Registros",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/registros" }
        },
        {
          "name": "GET Registro by ID",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/registros/{{registro_id}}" }
        },
        {
          "name": "POST Crear Registro",
